--- a/pm/packages.py
+++ b/pm/packages.py
@@ -285,9 +285,26 @@ class Python(_BionicDebArm, BinaryPackage, DebPackage):
         return pbs_versions(minor, _RUST_TRIPLE[target])
 
 
+def _uv_lock_identity(data: bytes) -> bytes:
+    """uv.lock with its download-source fields removed.
+
+    Hermes Portable switches a lock between PyPI and a mirror (Nexus) by
+    rewriting only registry/url values; names, versions and hashes stay put.
+    The venv built from either lock is identical, so the stamp must be too.
+    """
+    import re
+
+    data = re.sub(rb'\b(?:url|registry|upload-time|size) = (?:"[^"]*"|[0-9]+)', b"", data)
+    data = re.sub(rb"(?m)^exclude-newer.*\n", b"", data)
+    data = re.sub(rb"\{[\s,]*", b"{ ", data)
+    data = re.sub(rb"[\s,]*\}", b" }", data)
+    return re.sub(rb",(?:\s*,)+", b",", data)
+
+
 def _uv_lock_digest(path: Path) -> bytes:
-    """sha256 of uv.lock, cached on (mtime_ns, size) — check() runs at
