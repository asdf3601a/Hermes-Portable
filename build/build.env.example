# Hermes Portable build settings: copy to build/build.env (git-ignored) for local
# builds. CI passes the same names as workflow inputs or repository variables.
# Environment variables win over this file. Names and meaning match
# config/portable.env (docs/CONFIGURATION.md); unset = original public sources.

# --- Build entirely from Nexus ---------------------------------------------------
# The lock files of the build are switched before anything is downloaded.
#HP_PYPI_INDEX_URL=https://nexus.example.com/repository/pypi-proxy/simple
#HP_NPM_REGISTRY=https://nexus.example.com/repository/npm-proxy/
# discover (read the mirror's index pages) or rewrite (URL template, offline)
#HP_PYPI_LOCK_MODE=discover
#HP_PYPI_FILES_TEMPLATE=nexus

# Closed networks: mirrors for binaries that are not PyPI/npm packages.
# Raw proxy of https://hermes-assets.nousresearch.com (Python, Node, PortableGit,
# Chromium, ffmpeg, uv, ripgrep; verified by sha256)
#HP_ARTIFACT_MIRROR=https://nexus.example.com/repository/hermes-assets
# Raw proxies of https://github.com/electron/electron/releases/download/ and
# https://github.com/electron-userland/electron-builder-binaries/releases/download/
#HP_ELECTRON_MIRROR=https://nexus.example.com/repository/electron/
#HP_ELECTRON_BUILDER_BINARIES_MIRROR=https://nexus.example.com/repository/electron-builder-binaries/

# --- Proxy / TLS ----------------------------------------------------------------------
#HP_HTTP_PROXY=http://proxy.example.com:8080
#HP_HTTPS_PROXY=http://proxy.example.com:8080
#HP_NO_PROXY=.example.com
#HP_SSL_USE_SYSTEM_STORE=1
#HP_SSL_CA_FILE=build/corp-root-ca.pem
#HP_SSL_INSECURE=0

# --- Build locations ---------------------------------------------------------------------
# Work root (keep it short: C:\hpb). Default: .build in the repository.
#HP_BUILD_DIR=C:\hpb
# Host Python 3.11+ that drives upstream's bundle scripts. Default: python, then py -3.13
#HP_BUILD_PYTHON=python
