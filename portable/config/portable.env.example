# Hermes Portable settings
# =======================
# Copy this file to config\portable.env and edit it with any text editor.
# KEY=VALUE per line; lines starting with # are comments; quotes are optional.
# ${HP_ROOT} expands to the portable folder. Relative paths are relative to it.
#
# Only this file (and data\hermes\.env, Hermes' own) shape the agent's
# environment: variables from Windows / your user account are not inherited
# unless listed in HP_ENV_PASSTHROUGH. Full reference: docs\CONFIGURATION.md

# --- Package mirrors (Nexus) -------------------------------------------------
# PyPI mirror simple index. Credentials may be embedded (https://user:pass@host/...).
# After setting it, switch the lock files once:
#   hermes-portable sources pypi use-nexus
#HP_PYPI_INDEX_URL=https://nexus.example.com/repository/pypi-proxy/simple
# Optional additional indexes (space or comma separated)
#HP_PYPI_EXTRA_INDEX_URLS=
# URL template for `sources pypi use-nexus --mode rewrite` (nexus | artifactory | custom)
#HP_PYPI_FILES_TEMPLATE=nexus

# npm mirror registry. Then: hermes-portable sources npm use-nexus
#HP_NPM_REGISTRY=https://nexus.example.com/repository/npm-proxy/
# npm auth token for the registry (or embed user:pass in HP_NPM_REGISTRY)
#HP_NPM_AUTH_TOKEN=

# Raw-proxy mirror of https://hermes-assets.nousresearch.com for Hermes tool
# downloads (Python/Node/Chromium/... lazy installs), verified by sha256.
#HP_ARTIFACT_MIRROR=https://nexus.example.com/repository/hermes-assets

# Hugging Face mirror (local speech / model downloads)
#HP_HF_ENDPOINT=https://nexus.example.com/repository/huggingface

# --- Proxy ---------------------------------------------------------------------
#HP_HTTP_PROXY=http://proxy.example.com:8080
#HP_HTTPS_PROXY=http://proxy.example.com:8080
# Hosts that bypass the proxy (localhost/127.0.0.1/::1 are always added)
#HP_NO_PROXY=.example.com,10.0.0.0/8

# --- TLS / certificates ------------------------------------------------------------
# 1) Use the Windows certificate store (default 1). Corporate root CAs deployed
#    by IT, or imported with `certutil -user -addstore Root corp-root.cer`, work.
#HP_SSL_USE_SYSTEM_STORE=1
# 2) Extra CA certificate(s) in PEM format, added to the public roots
#HP_SSL_CA_FILE=config\corp-root-ca.pem
# 3) LAST RESORT: disable certificate verification everywhere (uv, npm, Node,
#    git, curl, Python, Desktop). Only for TLS-intercepting proxies you trust.
#HP_SSL_INSECURE=0
# Extra hosts for uv's insecure list (mirror/index hosts are added automatically)
#HP_SSL_INSECURE_HOSTS=

# --- Environment isolation -----------------------------------------------------
# Host variable names (globs) the agent may inherit, e.g. a key managed by IT
#HP_ENV_PASSTHROUGH=OPENAI_API_KEY AZURE_*
# Append the Windows PATH after the bundled tools (default 0: bundled tools only)
#HP_INHERIT_PATH=0

# --- Behaviour -----------------------------------------------------------------------
# Folder for all data (sessions, settings, caches). Default: data
#HP_DATA_DIR=data
# Where the shell / TUI / Desktop terminal start (default: your Windows profile)
#HP_START_DIR=
# Let Hermes download optional components on first use (default 1)
#HP_ALLOW_LAZY_INSTALLS=1
# Stop the background gateway when the last Hermes Desktop window closes (default 1)
#HP_STOP_GATEWAY_ON_EXIT=1
# Close the TUI window when the TUI exits instead of dropping to a shell (default 0)
#HP_EXIT_AFTER_AUTORUN=0

# --- Your own variables -----------------------------------------------------------------
# Any other KEY=VALUE is exported to Hermes as-is, for example:
#OPENAI_API_KEY=sk-...
