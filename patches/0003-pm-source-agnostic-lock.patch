+    on (mtime_ns, size) — check() runs at every startup and uv.lock is
+    megabyte-class."""
     import hashlib
 
     stat = path.stat()
@@ -295,7 +312,7 @@ def _uv_lock_digest(path: Path) -> bytes:
     cached = _uv_lock_digest_cache.get(path)
     if cached and cached[0] == key:
         return cached[1]
-    digest = hashlib.sha256(path.read_bytes()).digest()
+    digest = hashlib.sha256(_uv_lock_identity(path.read_bytes())).digest()
     _uv_lock_digest_cache[path] = (key, digest)
